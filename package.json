{
  "name": "realtime-chat",
  "private": true,
  "dependencies": {
    "ably": "^2.29.0",
    "argon2": "^0.45.1",
    "jose": "^6.2.12",
    "mongoose": "^8.9.0",
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "client",
    "server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:legacy": "npm run build --workspace=@chat/shared && npm run build --workspace=server && npm run build --workspace=@chat/client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server"
  }
